# Kashira Finance API — variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env con secretos reales al repositorio.

# Cadena de conexión PostgreSQL (Neon) — requiere sslmode=require
DATABASE_URL=

# Secreto de firma JWT (generar con: openssl rand -base64 48)
JWT_SECRET=

# Expiración del token JWT
JWT_EXPIRES_IN=7d

# Puerto HTTP del backend
PORT=3000

# Origen permitido del frontend (CORS)
CORS_ORIGIN=http://localhost:4200

# SMTP para envío de correos (Gmail: requiere contraseña de aplicación de 16 caracteres)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KashiraFinance <no-reply@kashirafinance.com>"

# Usuarios de prueba para seed y smoke tests (opcionales; el seed trae estos defaults)
# NUNCA definirlos en producción: el seed los omite si NODE_ENV=production
TEST_USER_EMAIL=user@test.local
TEST_USER_PASSWORD=Test1234*
TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=Admin1234*
