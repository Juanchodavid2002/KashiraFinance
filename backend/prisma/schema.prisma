generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum EnvelopeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EnvelopeMovementType {
  CONTRIBUTE
  SPEND
}

enum DebtKind {
  ENTITY
  PERSONAL
}

enum Currency {
  COP
  USD
  MXN
  EUR
  ARS
  CLP
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  currency     Currency @default(COP)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses            Expense[]
  incomes             Income[]
  envelopes           Envelope[]
  envelopeMovements   EnvelopeMovement[]
  categories          Category[]
  debts               Debt[]
  services            Service[]
  passwordResetCodes  PasswordResetCode[]
  hiddenCategories    UserHiddenCategory[]

  @@map("users")
}

model PasswordResetCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_reset_codes")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  icon      String?
  isDefault Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  hiddenBy  UserHiddenCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("categories")
}

model UserHiddenCategory {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
  @@map("user_hidden_categories")
}

model Expense {
  id            String        @id @default(uuid())
  userId        String
  categoryId    String
  description   String?
  amount        Decimal       @db.Decimal(14, 2)
  expenseDate   DateTime      @db.Date
  paymentMethod PaymentMethod @default(CASH)
  notes           String?
  debtPaymentId   String?  @db.Uuid
  servicePaymentId String? @db.Uuid  @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, expenseDate(sort: Desc)])
  @@index([userId, categoryId])
  @@index([debtPaymentId])
  @@map("expenses")

  envelopeMovements EnvelopeMovement[]
}

model Envelope {
  id           String            @id @default(uuid())
  userId       String
  name         String
  frequency    EnvelopeFrequency
  dayOfMonth   Int               @default(1)
  amount       Decimal           @db.Decimal(14, 2)
  balance      Decimal           @db.Decimal(14, 2)
  lastRecurredAt DateTime?
  notes        String?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements    EnvelopeMovement[]
  services     Service[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, name])
  @@map("envelopes")
}

model EnvelopeMovement {
  id         String               @id @default(uuid())
  envelopeId String
  userId     String
  type       EnvelopeMovementType
  amount     Decimal              @db.Decimal(14, 2)
  notes      String?
  expenseId  String?              @unique
  envelope   Envelope             @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  expense    Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([envelopeId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("envelope_movements")
}

model Income {
  id          String   @id @default(uuid())
  userId      String
  description String?
  amount      Decimal  @db.Decimal(14, 2)
  incomeDate  DateTime @db.Date
  source      String?
  notes       String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, incomeDate(sort: Desc)])
  @@map("incomes")
}

model Debt {
  id                String   @id @default(uuid())
  userId            String
  kind              DebtKind
  name              String
  lender            String?
  totalAmount       Decimal  @db.Decimal(14, 2)
  totalInstallments Int?
  paidInstallments  Int?
  installmentAmount Decimal? @db.Decimal(14, 2)
  startDate         DateTime @db.Date
  dueDate           DateTime? @db.Date
  notes             String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments          DebtPayment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("debts")
}

model DebtPayment {
  id        String   @id @default(uuid())
  debtId    String
  userId    String
  amount    Decimal  @db.Decimal(14, 2)
  paidDate  DateTime @db.Date
  notes     String?
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([debtId, paidDate(sort: Desc)])
  @@map("debt_payments")
}

model Service {
  id        String    @id @default(uuid())
  userId    String
  name      String
  color     String?
  icon      String?
  notes     String?
  envelopeId String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope  Envelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  payments  ServicePayment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("services")
}

model ServicePayment {
  id        String   @id @default(uuid())
  serviceId String
  userId    String
  amount    Decimal  @db.Decimal(14, 2)
  paidDate  DateTime @db.Date
  notes     String?
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, paidDate(sort: Desc)])
  @@map("service_payments")
}
