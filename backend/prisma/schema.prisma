generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum EnvelopeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EnvelopeMovementType {
  CONTRIBUTE
  SPEND
}

enum DebtKind {
  ENTITY
  PERSONAL
}

enum Currency {
  COP
  USD
  MXN
  EUR
  ARS
  CLP
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique
  name         String
  passwordHash String
  currency     Currency @default(COP)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses            Expense[]
  incomes             Income[]
  envelopes           Envelope[]
  envelopeMovements   EnvelopeMovement[]
  categories          Category[]
  debts               Debt[]
  providers           Provider[]
  budgets             Budget[]
  budgetLines         BudgetLine[]
  services            Service[]
  savingsGoals        SavingsGoal[]
  savingsMovements    SavingsMovement[]
  passwordResetCodes  PasswordResetCode[]
  hiddenCategories    UserHiddenCategory[]

  @@map("users")
}

model PasswordResetCode {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_reset_codes")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  icon      String?
  isDefault Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  hiddenBy  UserHiddenCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("categories")
}

model UserHiddenCategory {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
  @@map("user_hidden_categories")
}

model Expense {
  id            String        @id @default(uuid())
  userId        String
  categoryId    String
  description   String?
  amount        Decimal       @db.Decimal(14, 2)
  expenseDate   DateTime      @db.Date
  paymentMethod PaymentMethod @default(CASH)
  notes           String?
  debtPaymentId   String?  @db.Uuid
  servicePaymentId String? @db.Uuid  @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, expenseDate(sort: Desc)])
  @@index([userId, categoryId])
  @@index([debtPaymentId])
  @@map("expenses")

  envelopeMovements EnvelopeMovement[]
}

model Envelope {
  id           String            @id @default(uuid())
  userId       String
  name         String
  frequency    EnvelopeFrequency
  dayOfMonth   Int               @default(1)
  amount       Decimal           @db.Decimal(14, 2)
  balance      Decimal           @db.Decimal(14, 2)
  lastRecurredAt DateTime?
  notes        String?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements    EnvelopeMovement[]
  services     Service[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, name])
  @@map("envelopes")
}

model EnvelopeMovement {
  id         String               @id @default(uuid())
  envelopeId String
  userId     String
  type       EnvelopeMovementType
  amount     Decimal              @db.Decimal(14, 2)
  notes      String?
  expenseId  String?              @unique
  envelope   Envelope             @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  expense    Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([envelopeId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("envelope_movements")
}

model Income {
  id          String   @id @default(uuid())
  userId      String
  description String?
  amount      Decimal  @db.Decimal(14, 2)
  incomeDate  DateTime @db.Date
  source      String?
  providerId  String?
  notes       String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, incomeDate(sort: Desc)])
  @@index([providerId])
  @@map("incomes")
}

model Debt {
  id                String   @id @default(uuid())
  userId            String
  kind              DebtKind
  interestType      String   @default("NONE")
  interestRate      Decimal? @db.Decimal(7, 2)
  interestPeriod    String?
  name              String
  lender            String?
  providerId        String?
  totalAmount       Decimal  @db.Decimal(14, 2)
  totalInstallments Int?
  paidInstallments  Int?
  installmentAmount Decimal? @db.Decimal(14, 2)
  startDate         DateTime @db.Date
  dueDate           DateTime? @db.Date
  notes             String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  payments          DebtPayment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([providerId])
  @@map("debts")
}

model Provider {
  id        String   @id @default(uuid())
  userId    String
  name      String
  notes     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debts     Debt[]
  incomes   Income[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("providers")
}

model DebtPayment {
  id            String    @id @default(uuid())
  debtId        String
  userId        String
  amount        Decimal   @db.Decimal(14, 2)
  capitalAmount Decimal?  @db.Decimal(14, 2)
  paidDate      DateTime  @db.Date
  notes         String?
  debt          Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([debtId, paidDate(sort: Desc)])
  @@map("debt_payments")
}

model Service {
  id        String    @id @default(uuid())
  userId    String
  name      String
  color     String?
  icon      String?
  notes     String?
  envelopeId String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope  Envelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  payments  ServicePayment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("services")
}

model ServicePayment {
  id        String   @id @default(uuid())
  serviceId String
  userId    String
  amount    Decimal  @db.Decimal(14, 2)
  paidDate  DateTime @db.Date
  notes     String?
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, paidDate(sort: Desc)])
  @@map("service_payments")
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(14, 2)
  balance       Decimal   @db.Decimal(14, 2) @default(0)
  deadline      DateTime? @db.Date
  notes         String?
  status        String    @default("ACTIVE")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements     SavingsMovement[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("savings_goals")
}

model SavingsMovement {
  id            String      @id @default(uuid())
  goalId        String
  userId        String
  type          SavingsMovementType
  amount        Decimal     @db.Decimal(14, 2)
  notes         String?
  goal          SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([goalId, createdAt(sort: Desc)])
  @@map("savings_movements")
}

enum SavingsMovementType {
  DEPOSIT
  WITHDRAW
}

enum BudgetLineType {
  INCOME
  EXPENSE
}

/// Presupuesto / simulador: no toca los ingresos ni gastos reales.
model Budget {
  id        String       @id @default(uuid())
  userId    String
  name      String
  notes     String?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines     BudgetLine[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("budgets")
}

model BudgetLine {
  id        String         @id @default(uuid())
  budgetId  String
  userId    String
  type      BudgetLineType
  name      String         @default("")
  amount    Decimal        @default(0) @db.Decimal(16, 2)
  included  Boolean        @default(true)
  position  Int            @default(0)
  budget    Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([budgetId, position])
  @@map("budget_lines")
}
